# GEMINI_API_KEY: Required for Gemini AI API calls (Jarvis /ask, /outline, /refine).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional OpenAI — enables Whisper STT and TTS when running `python jarvis.py --voice`
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Audio defaults for sounddevice
JARVIS_SAMPLE_RATE=16000
JARVIS_CHANNELS=1
JARVIS_RECORD_SECONDS=5
JARVIS_INPUT_DEVICE=
JARVIS_OUTPUT_DEVICE=

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000
